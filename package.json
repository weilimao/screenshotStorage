{
  "name": "screenshot-storage",
  "version": "1.1.5",
  "description": "截图智能暂存箱 - 解决 CLI 终端无法粘贴图片的问题",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "tsc && electron .",
    "dev": "tsc && electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "publish": "node scripts/publish.js"
  },
  "build": {
    "appId": "com.screenshot.storage",
    "releaseInfo": {
      "releaseNotes": "1. 新增截图成功屏中央 Toast 独立浮窗：微信式快捷截图完成后，自动在截图所在的屏幕中央弹出独立的成功提示浮窗，支持混合 DPI 与多屏感知。\n2. 优化 Windows CMD 打包脚本：将 build.bat 编码调整为 ANSI/GBK 格式，修复脚本在命令提示符下中文乱码及语句中断 Bug。"
    },
    "productName": "截图智能暂存箱",
    "artifactName": "screenshot-storage-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "weilimao",
        "repo": "screenshotStorage"
      }
    ],
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*.html",
      "src/renderer/**/*.css",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/tray.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "截图智能暂存箱"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "chokidar": "^3.6.0",
    "electron-screenshots": "^0.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "electron": "^28.2.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.3.3"
  }
}
