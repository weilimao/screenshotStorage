{
  "name": "screenshot-storage",
  "version": "1.0.4",
  "description": "截图智能暂存箱 - 解决 CLI 终端无法粘贴图片的问题",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "tsc && electron .",
    "dev": "tsc && electron .",
    "dist": "npm run build && electron-builder",
    "publish": "node scripts/publish.js"
  },
  "build": {
    "appId": "com.screenshot.storage",
    "releaseInfo": {
      "releaseNotes": "1. 修复了打包后开机自启开关无法正常开启的 bug\n2. 优化了检测更新和无更新提示模态框的 UI 视觉效果"
    },
    "productName": "截图智能暂存箱",
    "artifactName": "screenshot-storage-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "weilimao",
        "repo": "screenshotStorage"
      }
    ],
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*.html",
      "src/renderer/**/*.css",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/tray.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "截图智能暂存箱"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "electron": "^28.2.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.3.3"
  }
}