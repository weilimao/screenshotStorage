{
  "name": "screenshot-storage",
  "version": "1.1.0",
  "description": "截图智能暂存箱 - 解决 CLI 终端无法粘贴图片的问题",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "tsc && electron .",
    "dev": "tsc && electron .",
    "dist": "npm run build && electron-builder",
    "publish": "node scripts/publish.js"
  },
  "build": {
    "appId": "com.screenshot.storage",
    "releaseInfo": {
      "releaseNotes": "1. 修复了多显示器环境下点击悬浮窗截图时，由于 Windows 前台锁限制导致前两个屏幕遮罩失效闪退的 bug。\n2. 优化了悬浮窗截图触发时的焦点释放逻辑，反应速度大幅提升，与快捷键截图一样快如闪电。\n3. 优化了截图遮罩层级，采用 screen-saver 级别置顶，确保在各种置顶窗口层叠时依然能 100% 成功选取截图。"
    },
    "productName": "截图智能暂存箱",
    "artifactName": "screenshot-storage-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "weilimao",
        "repo": "screenshotStorage"
      }
    ],
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*.html",
      "src/renderer/**/*.css",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/tray.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "截图智能暂存箱"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "chokidar": "^3.6.0",
    "electron-screenshots": "^0.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "electron": "^28.2.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.3.3"
  }
}
